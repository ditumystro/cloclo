# Obligatoire : ta clé API (https://platform.claude.com)
ANTHROPIC_API_KEY=sk-ant-...

# Fortement conseillé une fois en ligne : sinon n'importe qui peut dépenser ta clé
APP_PASSWORD=choisis-un-mot-de-passe

# Optionnel
MAX_TOKENS=32000
RATE_LIMIT_PER_MIN=20
CLAUDE_MODEL_FAST=claude-haiku-5-5
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_MODEL_DEEP=claude-opus-5-5

# Taille max des fichiers joints par requête, en Mo
MAX_UPLOAD_MB=20

# ---- Accès sur approbation (laisser OWNER_EMAIL vide pour une app ouverte)
# Adresse qui reçoit les demandes d'accès
OWNER_EMAIL=ton.adresse@gmail.com
# Clé de signature des accès (longue chaîne aléatoire). La changer révoque tous les accès.
ACCESS_SECRET=change-moi-par-une-longue-chaine-aleatoire
# Adresse publique de l'app (pour les liens de l'e-mail), ex. https://cloclo-xxxx.onrender.com
PUBLIC_URL=
# Accès à retirer : identifiants séparés par des virgules (indiqués dans l'e-mail)
REVOKED_ACCESS=

# Envoi de l'e-mail : Gmail (mot de passe d'application) ...
GMAIL_ADDRESS=ton.adresse@gmail.com
GMAIL_APP_PASSWORD=
# ... ou Resend (https://resend.com), qui passe par HTTPS : prioritaire s'il est défini
RESEND_API_KEY=
